---
/**
 * The diner stereo: a chrome-framed Spotify playlist embed.
 *
 * The iframe is left exactly as Spotify's generator emits it. Their docs warn
 * that editing the markup can drop playback down to 30-second previews, so all
 * the styling lives on the wrapper around it.
 *
 * Visitors signed in to Spotify hear full tracks; everyone else gets previews.
 * That is Spotify's rule, not something the page can change.
 */
const PLAYLIST_ID = '5vNyTszThDT3T7U0pdHJJU';

// theme=0 is the dark player, which suits the late-night palette.
const embedSrc = `https://open.spotify.com/embed/playlist/${PLAYLIST_ID}?utm_source=generator&theme=0`;
const playlistUrl = `https://open.spotify.com/playlist/${PLAYLIST_ID}`;
---

<section class="stereo" aria-labelledby="stereo-heading">
  <div class="stereo__plate">
    <p class="stereo__eyebrow">
      <span class="stereo__led" aria-hidden="true"></span>
      On the diner stereo
    </p>
    <h2 class="stereo__heading" id="stereo-heading">Booth Selections</h2>
  </div>

  <div class="stereo__screen">
    <iframe
      style="border-radius:12px"
      src={embedSrc}
      width="100%"
      height="352"
      frameborder="0"
      allowfullscreen
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
      title="Booth Selections playlist on Spotify"></iframe>
  </div>

  <p class="stereo__fine">
    Signed in to Spotify? You get the whole record. Otherwise it&rsquo;s a
    30-second taste &mdash; <a href={playlistUrl} rel="noopener">open the
    playlist in Spotify</a> for the full set.
  </p>
</section>

<style>
  .stereo {
    position: relative;
    width: min(620px, 100%);
    margin-top: clamp(3.5rem, 8vw, 5rem);
    padding: clamp(1.1rem, 3.5vw, 1.6rem);
    border: 5px solid var(--cream);
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgba(42, 39, 69, 0.95), rgba(17, 16, 30, 0.97));
    box-shadow:
      0 0 0 6px var(--red-deep),
      0 0 0 9px rgba(0, 0, 0, 0.35),
      0 22px 50px rgba(0, 0, 0, 0.55);
  }

  /* Brushed-metal nameplate across the top of the cabinet. */
  .stereo__plate {
    margin: 0 0 clamp(0.9rem, 3vw, 1.25rem);
    padding: 0.7rem 1rem 0.8rem;
    border-radius: 14px;
    background: linear-gradient(
      180deg,
      #ffffff,
      #ced4dc 42%,
      #79818d 54%,
      #dde2e8 74%,
      #959ca6
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 3px 8px rgba(0, 0, 0, 0.45);
    text-align: center;
    color: #20202f;
  }

  .stereo__eyebrow {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    font-size: clamp(0.58rem, 2vw, 0.68rem);
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #4a4a5e;
  }

  .stereo__led {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 8px var(--red);
    animation: stereo-pulse 2.4s ease-in-out infinite alternate;
  }

  @keyframes stereo-pulse {
    from {
      opacity: 0.35;
    }
    to {
      opacity: 1;
    }
  }

  .stereo__heading {
    margin: 0.3rem 0 0;
    font-family: 'Bowlby One SC', Impact, sans-serif;
    font-size: clamp(1.15rem, 4.5vw, 1.7rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--red-deep);
    text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.55);
  }

  /* Recessed well so the player reads as set into the cabinet. */
  .stereo__screen {
    border-radius: 14px;
    padding: 6px;
    background: rgba(0, 0, 0, 0.45);
    box-shadow:
      inset 0 2px 10px rgba(0, 0, 0, 0.7),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    line-height: 0;
  }

  .stereo__fine {
    margin: clamp(0.8rem, 2.5vw, 1rem) 0 0;
    text-align: center;
    font-size: 0.76rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: rgba(255, 233, 196, 0.62);
  }

  .stereo__fine a {
    color: var(--mustard);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .stereo__fine a:hover,
  .stereo__fine a:focus-visible {
    color: var(--cream);
  }

  @media (prefers-reduced-motion: reduce) {
    .stereo__led {
      animation: none;
      opacity: 1;
    }
  }
</style>
